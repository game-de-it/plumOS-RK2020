#!/bin/sh
set -u

PATH=/usr/sbin:/usr/bin:/sbin:/bin
export PATH

USB_ONLINE="${PLUMOS_USB_HOST_USB_ONLINE:-/sys/class/power_supply/usb/online}"
USB_DEVICES_ROOT="${PLUMOS_USB_HOST_DEVICES_ROOT:-/sys/bus/usb/devices}"
DWC2_DRIVER="${PLUMOS_USB_HOST_DWC2_DRIVER:-/sys/bus/platform/drivers/dwc2}"
PLATFORM_DEVICE="${PLUMOS_USB_HOST_PLATFORM_DEVICE:-/sys/bus/platform/devices/ff300000.usb}"
DEVICE_ID="${PLUMOS_USB_HOST_DEVICE_ID:-ff300000.usb}"
OTG_MODE="${PLUMOS_USB_HOST_OTG_MODE:-/sys/devices/platform/ff2c0000.syscon/ff2c0000.syscon:usb2-phy@100/otg_mode}"
WPA_CONFIG="${PLUMOS_USB_HOST_WPA_CONFIG:-/mnt/plumos/config/wpa_supplicant.conf}"
LOG="${PLUMOS_USB_HOST_LOG:-/state/plumos/logs/usb-host-reenumerate.log}"
RESET_DELAY="${PLUMOS_USB_HOST_RESET_DELAY:-2}"
MODE_SETTLE="${PLUMOS_USB_HOST_MODE_SETTLE:-1}"
ENUMERATION_WAIT="${PLUMOS_USB_HOST_ENUMERATION_WAIT:-3}"
PRE_RESET_WAIT="${PLUMOS_USB_HOST_PRE_RESET_WAIT:-3}"
# The V90S-proven 1a2b -> c811 path gives the SCSI eject/re-enumeration loop
# five seconds. Keep RK2020 in host mode beyond that complete window so its
# delayed 1a2b remove handler cannot race the c811 add event at second five.
RELEASE_DELAY="${PLUMOS_USB_HOST_RELEASE_DELAY:-8}"
LOCK_WAIT="${PLUMOS_USB_HOST_LOCK_WAIT:-8}"
LOCK_DIR="${PLUMOS_USB_HOST_LOCK_DIR:-/run/plumos/usb-host-control.lock}"
TRANSITION_MARKER="${PLUMOS_USB_HOST_TRANSITION_MARKER:-/run/plumos/usb-host-probe-active}"
BUSYBOX="${PLUMOS_USB_HOST_BUSYBOX:-/bin/busybox}"
MODPROBE="${PLUMOS_USB_HOST_MODPROBE:-/sbin/modprobe}"
DWC2_MODULE="${PLUMOS_USB_HOST_DWC2_MODULE:-dwc2}"
CONTROLLER_WAIT="${PLUMOS_USB_HOST_CONTROLLER_WAIT:-3}"
PHY_STATUS_ADDR="${PLUMOS_USB_HOST_PHY_STATUS_ADDR:-0xff2c0120}"
PHY_BVALID_MASK="${PLUMOS_USB_HOST_PHY_BVALID_MASK:-0x200}"
PHY_STATUS_FILE="${PLUMOS_USB_HOST_PHY_STATUS_FILE:-}"
DWC2_GUSBCFG_ADDR="${PLUMOS_USB_HOST_DWC2_GUSBCFG_ADDR:-0xff30000c}"
DWC2_GUSBCFG_FILE="${PLUMOS_USB_HOST_DWC2_GUSBCFG_FILE:-}"
DWC2_FORCEHOST_MASK=0x20000000
DWC2_FORCEDEV_MASK=0x40000000

log() {
    mkdir -p "${LOG%/*}"
    printf '%s service=usb-host-reenumerate %s\n' \
        "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$*" >>"$LOG"
}

wifi_requested() {
    [ -s "$WPA_CONFIG" ] || return 1
    return 0
}

usb_upstream_online() {
    [ -r "$USB_ONLINE" ] || return 1
    value=$(tr -d '[:space:]' <"$USB_ONLINE" 2>/dev/null || true)
    [ "$value" = 1 ]
}

downstream_present() {
    for device in "$USB_DEVICES_ROOT"/*; do
        [ -r "$device/idVendor" ] || continue
        case "${device##*/}" in usb*) continue ;; esac
        return 0
    done
    return 1
}

wait_for_downstream() {
    limit="$1"
    elapsed=0
    while [ "$elapsed" -lt "$limit" ]; do
        downstream_present && return 0
        sleep 1
        elapsed=$((elapsed + 1))
    done
    downstream_present
}

ensure_dwc2_controller() {
    [ -d "$PLATFORM_DEVICE" ] || {
        log "result=failed reason=controller-missing device=$DEVICE_ID"
        return 1
    }
    if [ -L "$PLATFORM_DEVICE/driver" ]; then
        return 0
    fi
    [ -x "$MODPROBE" ] || {
        log "result=failed reason=modprobe-missing path=$MODPROBE module=$DWC2_MODULE"
        return 1
    }
    if ! "$MODPROBE" "$DWC2_MODULE" >>"$LOG" 2>&1; then
        log "result=failed reason=module-load-failed module=$DWC2_MODULE"
        return 1
    fi
    log "stage=module-loaded module=$DWC2_MODULE"
    elapsed=0
    while [ "$elapsed" -lt "$CONTROLLER_WAIT" ]; do
        [ -L "$PLATFORM_DEVICE/driver" ] && break
        sleep 1
        elapsed=$((elapsed + 1))
    done
    [ -L "$PLATFORM_DEVICE/driver" ] || {
        log "result=failed reason=controller-bind-timeout device=$DEVICE_ID wait=$CONTROLLER_WAIT"
        return 1
    }
    log "stage=controller-bound device=$DEVICE_ID elapsed=$elapsed"
}

valid_register_value() {
    printf '%s\n' "$1" | grep -Eq '^(0[xX][0-9a-fA-F]+|[0-9]+)$'
}

read_dwc2_gusbcfg() {
    if [ -n "$DWC2_GUSBCFG_FILE" ]; then
        [ -r "$DWC2_GUSBCFG_FILE" ] || return 1
        value=$(tr -d '[:space:]' <"$DWC2_GUSBCFG_FILE" 2>/dev/null || true)
    else
        [ -L "$PLATFORM_DEVICE/driver" ] || return 1
        [ -x "$BUSYBOX" ] || return 1
        value=$("$BUSYBOX" devmem "$DWC2_GUSBCFG_ADDR" 32 2>/dev/null || true)
    fi
    valid_register_value "$value" || return 1
    printf '%s\n' "$value"
}

write_dwc2_gusbcfg() {
    value="$1"
    formatted=$(printf '0x%08x' "$value")
    if [ -n "$DWC2_GUSBCFG_FILE" ]; then
        printf '%s\n' "$formatted" >"$DWC2_GUSBCFG_FILE" || return 1
    else
        [ -L "$PLATFORM_DEVICE/driver" ] || return 1
        [ -x "$BUSYBOX" ] || return 1
        "$BUSYBOX" devmem "$DWC2_GUSBCFG_ADDR" 32 "$formatted" >/dev/null 2>&1 || return 1
    fi
    readback=$(read_dwc2_gusbcfg) || return 1
    [ "$((readback))" -eq "$value" ]
}

force_dwc2_host_register() {
    raw=$(read_dwc2_gusbcfg) || {
        log "result=warning reason=gusbcfg-read-failed address=$DWC2_GUSBCFG_ADDR"
        return 1
    }
    old=$((raw))
    new=$(((old & ~(DWC2_FORCEHOST_MASK | DWC2_FORCEDEV_MASK)) | DWC2_FORCEHOST_MASK))
    write_dwc2_gusbcfg "$new" || {
        log "result=warning reason=gusbcfg-host-write-failed address=$DWC2_GUSBCFG_ADDR"
        return 1
    }
    log "stage=host-mode-forced source=dwc2-register old=$(printf '0x%08x' "$old") new=$(printf '0x%08x' "$new")"
}

release_dwc2_auto_register() {
    raw=$(read_dwc2_gusbcfg) || {
        log "result=warning reason=gusbcfg-read-failed address=$DWC2_GUSBCFG_ADDR"
        return 1
    }
    old=$((raw))
    new=$((old & ~(DWC2_FORCEHOST_MASK | DWC2_FORCEDEV_MASK)))
    write_dwc2_gusbcfg "$new" || {
        log "result=warning reason=gusbcfg-release-write-failed address=$DWC2_GUSBCFG_ADDR"
        return 1
    }
    log "stage=otg-mode-released source=dwc2-register old=$(printf '0x%08x' "$old") new=$(printf '0x%08x' "$new")"
}

current_otg_mode() {
    [ -r "$OTG_MODE" ] || return 1
    tr -d '[:space:]' <"$OTG_MODE" 2>/dev/null
}

phy_bvalid() {
    # PX30/RK3326 exposes the OTG UTMI status at USB2PHY GRF + 0x120;
    # bit 9 is BVALID.  Read it only while the PHY is not forced to host,
    # because host mode's own VBUS source also asserts BVALID.
    if [ -n "$PHY_STATUS_FILE" ]; then
        [ -r "$PHY_STATUS_FILE" ] || return 1
        status=$(tr -d '[:space:]' <"$PHY_STATUS_FILE" 2>/dev/null || true)
    else
        [ -x "$BUSYBOX" ] || return 1
        status=$("$BUSYBOX" devmem "$PHY_STATUS_ADDR" 32 2>/dev/null || true)
    fi
    case "$status" in
        0x*|0X*|[0-9]*) ;;
        *) return 1 ;;
    esac
    [ $((status & PHY_BVALID_MASK)) -ne 0 ]
}

upstream_present() {
    usb_upstream_online && return 0
    mode=$(current_otg_mode 2>/dev/null || true)
    [ "$mode" = host ] && return 1
    phy_bvalid
}

release_wifi_host_mode() {
    mode=$(current_otg_mode 2>/dev/null || true)
    if [ "$mode" = otg ]; then
        log 'stage=otg-mode-ready source=sysfs'
        return 0
    fi
    if [ "$mode" != UNKNOWN ] && [ -w "$OTG_MODE" ]; then
        if printf 'otg\n' >"$OTG_MODE"; then
            mode=$(current_otg_mode 2>/dev/null || true)
            if [ "$mode" = otg ]; then
                log 'stage=otg-mode-released source=sysfs'
                sleep "$MODE_SETTLE"
                return 0
            fi
            log "result=warning reason=otg-mode-release-verify-failed mode=${mode:-unknown}"
        else
            log "result=warning reason=otg-mode-release-failed mode=${mode:-unknown} path=$OTG_MODE"
        fi
    fi
    release_dwc2_auto_register || {
        log "result=warning reason=otg-mode-release-unavailable mode=${mode:-missing}"
        return 1
    }
    sleep "$MODE_SETTLE"
}

force_wifi_host_mode() {
    mode=$(current_otg_mode 2>/dev/null || true)
    if [ "$mode" = host ]; then
        log 'stage=host-mode-ready source=sysfs'
        return 0
    fi
    if [ "$mode" != UNKNOWN ] && [ -w "$OTG_MODE" ]; then
        if printf 'host\n' >"$OTG_MODE"; then
            mode=$(current_otg_mode 2>/dev/null || true)
            if [ "$mode" = host ]; then
                log 'stage=host-mode-forced source=sysfs'
                sleep "$MODE_SETTLE"
                return 0
            fi
            log "result=warning reason=otg-mode-verify-failed mode=${mode:-unknown}"
        else
            log "result=warning reason=otg-mode-write-failed mode=${mode:-unknown} path=$OTG_MODE"
        fi
    fi
    force_dwc2_host_register || {
        log "result=warning reason=host-mode-force-unavailable mode=${mode:-missing}"
        return 1
    }
    sleep "$MODE_SETTLE"
}

worker() {
    require_saved_wifi="${1:-yes}"
    if [ "$require_saved_wifi" = yes ] && ! wifi_requested; then
        release_wifi_host_mode
        log 'result=skipped reason=wifi-not-requested'
        return 0
    fi
    [ -r "$USB_ONLINE" ] || {
        release_wifi_host_mode
        log "result=skipped reason=usb-upstream-signal-missing path=$USB_ONLINE"
        return 0
    }
    if downstream_present; then
        force_wifi_host_mode || true
        log 'result=skipped reason=downstream-already-enumerated'
        return 0
    fi
    if upstream_present; then
        release_wifi_host_mode
        log 'result=skipped reason=usb-upstream-online'
        return 0
    fi
    mkdir -p "${TRANSITION_MARKER%/*}"
    : >"$TRANSITION_MARKER"
    # mdev does not load platform modules from modaliases on this image.  Load
    # DWC2 explicitly, then first allow a permanently inserted dongle to follow
    # the controller's normal OTG/ID-pin path without touching its role bits.
    if ! ensure_dwc2_controller; then
        release_wifi_host_mode
        log 'result=failed reason=controller-unavailable'
        return 1
    fi
    if wait_for_downstream "$PRE_RESET_WAIT"; then
        log 'result=enumerated-after-controller-load'
        return 0
    fi
    # The stock RK2020 DTB disables the USB2 PHY child, so Rockchip's 4.4 PHY
    # driver can expose otg_mode=UNKNOWN.  Prefer its sysfs ABI when available;
    # otherwise change only DWC2 GUSBCFG FORCEHOST/FORCEDEV and preserve every
    # other controller bit.  A final DWC2 rebind remains the last fallback.
    if ! force_wifi_host_mode; then
        release_wifi_host_mode
        log 'result=failed reason=host-mode-unavailable owner=otg'
        return 1
    fi
    # Writing host is normally sufficient for a dongle that remained inserted
    # across boot.  Give that natural enumeration priority over a DWC2 reset;
    # otherwise the reset's remove uevent can be mistaken for physical unplug.
    if wait_for_downstream "$PRE_RESET_WAIT"; then
        log 'result=enumerated-after-host-force'
        return 0
    fi
    [ -w "$DWC2_DRIVER/bind" ] || {
        release_wifi_host_mode
        log "result=failed reason=bind-unavailable driver=$DWC2_DRIVER"
        return 1
    }

    if [ -L "$PLATFORM_DEVICE/driver" ]; then
        [ -w "$DWC2_DRIVER/unbind" ] || {
            release_wifi_host_mode
            log "result=failed reason=unbind-unavailable driver=$DWC2_DRIVER"
            return 1
        }
        printf '%s\n' "$DEVICE_ID" >"$DWC2_DRIVER/unbind" || {
            release_wifi_host_mode
            log 'result=failed stage=unbind'
            return 1
        }
        log "stage=unbound device=$DEVICE_ID"
        sleep "$RESET_DELAY"
    fi

    printf '%s\n' "$DEVICE_ID" >"$DWC2_DRIVER/bind" || {
        release_wifi_host_mode
        log 'result=failed stage=bind'
        return 1
    }
    log "stage=bound device=$DEVICE_ID"

    elapsed=0
    while [ "$elapsed" -lt "$ENUMERATION_WAIT" ]; do
        if downstream_present; then
            log "result=reenumerated elapsed=$elapsed"
            return 0
        fi
        sleep 1
        elapsed=$((elapsed + 1))
    done
    release_wifi_host_mode
    log 'result=reset-complete downstream=absent owner=otg'
}

release_if_idle() {
    if usb_upstream_online; then
        release_wifi_host_mode
        log 'result=released reason=usb-upstream-online'
        return 0
    fi
    if downstream_present; then
        log 'result=skipped reason=downstream-still-present'
        return 0
    fi
    release_wifi_host_mode
    log 'result=released reason=downstream-absent'
}

reconcile_role() {
    if downstream_present; then
        log 'result=reconciled owner=downstream-host'
        return 0
    fi
    if upstream_present; then
        release_wifi_host_mode
        log 'result=reconciled owner=upstream'
        return 0
    fi
    release_if_idle
}

release_requested() {
    release_wifi_host_mode
    log 'result=released reason=requested'
}

start_release_worker() {
    (
        sleep "$RELEASE_DELAY"
        exec "$0" release-if-idle
    ) </dev/null >>"$LOG" 2>&1 &
    log "result=release-scheduled pid=$! delay=$RELEASE_DELAY"
}

start_worker() {
    # Do not add DWC2 reset time to the boot critical path.  Service 20 starts
    # the Wi-Fi uevent monitor while this worker holds the controller unbound,
    # so the subsequent USB add is observed; its initial recovery is also a
    # fallback if enumeration wins the race.
    "$0" worker </dev/null >>"$LOG" 2>&1 &
    log "result=scheduled pid=$!"
}

cleanup_control_lock() {
    rm -f "$TRANSITION_MARKER" 2>/dev/null || true
    rmdir "$LOCK_DIR" 2>/dev/null || true
}

run_locked() {
    wait_policy="$1"
    operation="$2"
    shift 2
    elapsed=0
    mkdir -p "${LOCK_DIR%/*}"
    while ! mkdir "$LOCK_DIR" 2>/dev/null; do
        if [ "$wait_policy" != wait ] || [ "$elapsed" -ge "$LOCK_WAIT" ]; then
            log "result=skipped reason=operation-in-progress operation=$operation"
            return 0
        fi
        sleep 1
        elapsed=$((elapsed + 1))
    done
    trap cleanup_control_lock 0 1 2 15
    "$@"
    rc=$?
    cleanup_control_lock
    trap - 0 1 2 15
    return "$rc"
}

case "${1:-}" in
    start|worker)
        if [ "$1" = start ]; then
            start_worker
        else
            run_locked wait worker worker
        fi
        ;;
    probe)
        run_locked wait probe worker no
        ;;
    release)
        run_locked nowait release release_requested
        ;;
    release-if-idle)
        run_locked nowait release-if-idle release_if_idle
        ;;
    release-later)
        start_release_worker
        ;;
    reconcile)
        run_locked nowait reconcile reconcile_role
        ;;
    *)
        printf 'usage: %s {start|worker|probe|release|release-if-idle|release-later|reconcile}\n' "$0" >&2
        exit 2
        ;;
esac
