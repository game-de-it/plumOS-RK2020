#!/bin/sh
set -u

PATH=/usr/sbin:/usr/bin:/sbin:/bin
LOG=/state/plumos/logs/gpu.log

mkdir -p "${LOG%/*}"
mdev -s 2>/dev/null || true
chmod 0660 /dev/mali0 /dev/dri/card0 /dev/dri/renderD128 2>/dev/null || true

if [ -c /dev/mali0 ] || [ -c /dev/dri/card0 ]; then
    printf '%s service=gpu result=ready driver=stock-mali node=%s\n' \
        "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
        "$(test -c /dev/mali0 && echo /dev/mali0 || echo /dev/dri/card0)" >>"$LOG"
    exit 0
fi

printf '%s service=gpu result=failed driver=stock-mali\n' \
    "$(date -u +%Y-%m-%dT%H:%M:%SZ)" >>"$LOG"
exit 1
