--- a/sdl2/src/video/nds/nds_event.c
+++ b/sdl2/src/video/nds/nds_event.c
@@ -1747,6 +1747,41 @@
     }
 
     return 0;
+}
+
+#define RK2020_INPUT_DRAIN_MAX 64
+
+static int drain_rk2020_input(int fd)
+{
+    int count = 0;
+    int handled = 0;
+    struct input_event e = {{ 0 }};
+
+    while ((count < RK2020_INPUT_DRAIN_MAX) &&
+           (read(fd, &e, sizeof(e)) == sizeof(e)))
+    {
+        int changed = 0;
+
+        count += 1;
+        if ((e.type == EV_KEY) && (e.value != 2)) {
+            trace("code=%d, value=%d\n", e.code, e.value);
+            update_key_bit(e.code, e.value);
+            changed = 1;
+        }
+        else if ((e.type == EV_ABS) &&
+                 ((e.code == ABS_X) || (e.code == ABS_Y)))
+        {
+            trace("axis=%d, value=%d\n", e.code, e.value);
+            changed = handle_rk2020_stick_axis(&e);
+        }
+
+        if (changed) {
+            handle_hotkey();
+            handled = 1;
+        }
+    }
+
+    return handled;
 }
 #endif
 
