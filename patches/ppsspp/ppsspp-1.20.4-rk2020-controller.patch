+				"leftx:a0,lefty:a1,platform:Linux,";
+			const int result = SDL_GameControllerAddMapping(mapping.c_str());
+			if (result >= 0) {
+				INFO_LOG(Log::System, "Installed RK2020 controller mapping: %s", mapping.c_str());
+			} else {
+				ERROR_LOG(Log::System, "Failed to install RK2020 controller mapping: %s", SDL_GetError());
+			}
+		}
+		SDL_JoystickClose(rk2020Joystick);
