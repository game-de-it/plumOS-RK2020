diff --git a/engine/sdl/control.h b/engine/sdl/control.h
index 9450fdb..be4d790 100644
--- a/engine/sdl/control.h
+++ b/engine/sdl/control.h
@@ -17,7 +17,23 @@
 #endif
 #include "joysticks.h"
 
-#ifdef OPENDINGUX
+#ifdef PLUMOS_RK2020
+	/* OpenBOR packs 16 SDL buttons first, then two directional axes. */
+	#define CONTROL_ESC                 (JOY_LIST_FIRST + 11) /* SELECT, b10 */
+	#define CONTROL_DEFAULT1_UP         (JOY_LIST_FIRST + 7)  /* D-pad, b6 */
+	#define CONTROL_DEFAULT1_RIGHT      (JOY_LIST_FIRST + 10) /* D-pad, b9 */
+	#define CONTROL_DEFAULT1_DOWN       (JOY_LIST_FIRST + 8)  /* D-pad, b7 */
+	#define CONTROL_DEFAULT1_LEFT       (JOY_LIST_FIRST + 9)  /* D-pad, b8 */
+	#define CONTROL_DEFAULT1_FIRE1      (JOY_LIST_FIRST + 2)  /* Attack 1: Button 2 */
+	#define CONTROL_DEFAULT1_FIRE2      (JOY_LIST_FIRST + 3)  /* Attack 2: Button 3 */
+	#define CONTROL_DEFAULT1_FIRE3      (JOY_LIST_FIRST + 4)  /* Attack 3: Button 4 */
+	#define CONTROL_DEFAULT1_FIRE4      (JOY_LIST_FIRST + 5)  /* Attack 4: Button 5 */
+	#define CONTROL_DEFAULT1_FIRE5      (JOY_LIST_FIRST + 1)  /* Jump: Button 1 */
+	#define CONTROL_DEFAULT1_FIRE6      (JOY_LIST_FIRST + 6)  /* R1, b5 */
+	#define CONTROL_DEFAULT1_START      (JOY_LIST_FIRST + 16) /* START, b15 */
+	#define CONTROL_DEFAULT1_SCREENSHOT (JOY_LIST_FIRST + 13) /* Function, b12 */
+	#define CONTROL_DEFAULT1_ESC        (JOY_LIST_FIRST + 11) /* SELECT, b10 */
+#elif defined(OPENDINGUX)
 	#define	CONTROL_ESC                 OPENDINGUX_BUTTON_SELECT
 	#define	CONTROL_DEFAULT1_START		OPENDINGUX_BUTTON_START
 	#define	CONTROL_DEFAULT1_UP         OPENDINGUX_BUTTON_UP
diff --git a/engine/sdl/control.c b/engine/sdl/control.c
index f9983cd..26bb6b1 100644
--- a/engine/sdl/control.c
+++ b/engine/sdl/control.c
@@ -292,4 +292,14 @@ void getPads(Uint8* keystate, Uint8* keystate_def)
-				if(axis < -1*T_AXIS)  { joysticks[i].Axes |= 0x01 << (j*2); }
-				if(axis >    T_AXIS)  { joysticks[i].Axes |= 0x02 << (j*2); }
-			}
+				if(axis < -1*T_AXIS)  { joysticks[i].Axes |= 0x01 << (j*2); }
+				if(axis >    T_AXIS)  { joysticks[i].Axes |= 0x02 << (j*2); }
+			}
+#ifdef PLUMOS_RK2020
+			/* Make the measured ABS_X/ABS_Y stick mirror the physical D-pad. */
+			if(strcmp(joysticks[i].Name, "GO-Advance Gamepad") == 0)
+			{
+				if(joysticks[i].Axes & (0x01 << (JOY_AXIS_Y * 2))) joysticks[i].Buttons |= 0x01 << 6;
+				if(joysticks[i].Axes & (0x02 << (JOY_AXIS_X * 2))) joysticks[i].Buttons |= 0x01 << 9;
+				if(joysticks[i].Axes & (0x02 << (JOY_AXIS_Y * 2))) joysticks[i].Buttons |= 0x01 << 7;
+				if(joysticks[i].Axes & (0x01 << (JOY_AXIS_X * 2))) joysticks[i].Buttons |= 0x01 << 8;
+			}
+#endif
 
diff --git a/engine/sdl/video.c b/engine/sdl/video.c
index ff4b37e..68891ea 100644
--- a/engine/sdl/video.c
+++ b/engine/sdl/video.c
@@ -159,6 +159,11 @@ int video_set_mode(s_videomodes videomodes)
 	stored_videomodes = videomodes;
 	yuv_mode = 0;
 
+#ifdef PLUMOS_RK2020
+	savedata.fullscreen = 1;
+	savedata.stretch = 1;
+#endif
+
 	if(videomodes.hRes==0 && videomodes.vRes==0)
 	{
 		Term_Gfx();
@@ -193,6 +198,7 @@ int video_set_mode(s_videomodes videomodes)
 	                            videomodes.hRes, videomodes.vRes);
 
 	SDL_ShowCursor(SDL_DISABLE);
+	SDL_SetTextureBlendMode(texture, SDL_BLENDMODE_NONE);
 	SDL_SetRenderDrawBlendMode(renderer, SDL_BLENDMODE_BLEND);
 	video_stretch(savedata.stretch);
 
@@ -209,15 +215,20 @@ void video_fullscreen_flip()
 
 void blit()
 {
-	SDL_SetRenderDrawColor(renderer, 0, 0, 0, 0);
+	SDL_SetRenderDrawColor(renderer, 0, 0, 0, 255);
 	SDL_RenderClear(renderer);
 	SDL_RenderCopy(renderer, texture, NULL, NULL);
 
 	if (brightness > 0)
+	{
 		SDL_SetRenderDrawColor(renderer, 255, 255, 255, brightness-1);
+		SDL_RenderFillRect(renderer, NULL);
+	}
 	else if (brightness < 0)
+	{
 		SDL_SetRenderDrawColor(renderer, 0, 0, 0, (-brightness)-1);
-	SDL_RenderFillRect(renderer, NULL);
+		SDL_RenderFillRect(renderer, NULL);
+	}
 
 	SDL_RenderPresent(renderer);
 }
@@ -243,7 +254,7 @@ void video_clearscreen()
 {
 	if(opengl) { video_gl_clearscreen(); return; }
 
-	SDL_SetRenderDrawColor(renderer, 0, 0, 0, 0);
+	SDL_SetRenderDrawColor(renderer, 0, 0, 0, 255);
 	SDL_RenderClear(renderer);
 	SDL_RenderPresent(renderer);
 }
